# Normalize line endings -- critical for Windows + macOS/Linux mixed team
* text=auto eol=lf

# Force LF for shell scripts + configs
*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.sql       text eol=lf
*.toml      text eol=lf

# Force CRLF for Windows batch (rare in this project)
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary -- never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.mp4       binary
*.mp3       binary
*.wav       binary
