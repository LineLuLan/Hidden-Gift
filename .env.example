# =============================================================================
# Hidden Gift -- Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill values from each service dashboard.
# See docs/SETUP.md for service registration steps.
#
# Naming convention:
#   NEXT_PUBLIC_*  -> exposed to browser bundle (safe to commit on Vercel)
#   (no prefix)    -> server-only (NEVER expose to client)
#
# DO NOT commit .env.local. Only this .env.example file is committed.
# =============================================================================


# ----- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development


# ----- Supabase (https://supabase.com) ---------------------------------------
# Region: Singapore (ap-southeast-1)
# Project Settings -> API -> copy URL + anon key + service_role key
# Project Settings -> General -> Reference ID
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=


# ----- Better-Auth (https://better-auth.com) ---------------------------------
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


# ----- Google OAuth (https://console.cloud.google.com) -----------------------
# APIs & Services -> Credentials -> OAuth client ID -> Web Application
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ----- Cloudflare R2 (https://dash.cloudflare.com) ---------------------------
# R2 -> Create bucket -> Manage API Tokens -> Object Read & Write
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hidden-gift-memories
R2_PUBLIC_URL=


# ----- Trigger.dev v3 (https://trigger.dev) ----------------------------------
# Project Settings -> API Keys -> dev/prod secret key
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=


# ----- Resend (https://resend.com) -------------------------------------------
# Verify domain first, then API Keys -> Create
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev


# ----- Upstash Redis (https://upstash.com) -----------------------------------
# Region: Singapore. Type: Regional. TLS enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ----- PostHog (https://posthog.com) -----------------------------------------
# Project Settings -> Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ----- Sentry (https://sentry.io) --------------------------------------------
# Create Project -> Next.js -> copy DSN + auth token
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=hidden-gift


# ----- Plausible (https://plausible.io) --------------------------------------
# Marketing site analytics only -- defer tới khi có domain
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=


# ----- PayOS (https://payos.vn) -- Phase 3 only ------------------------------
# Requires business KYC. Leave blank until Phase 3 monetization launch.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
