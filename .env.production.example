# =============================================================================
# Hidden Gift — Production env template
# =============================================================================
# Copy values from your production accounts. NEVER commit .env.production.local.
# DO commit this template (.env.production.example) so the team knows what's required.
#
# Differences from .env.local:
#   - App URL points to production domain
#   - Resend domain is real (not @resend.dev)
#   - All optional service keys filled in for full feature parity
# =============================================================================

NEXT_PUBLIC_APP_URL=https://hiddengift.vn
NODE_ENV=production

# Supabase (production project — separate from dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Google OAuth (same project, production redirect added)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hidden-gift-memories
R2_PUBLIC_URL=https://media.hiddengift.vn

# Trigger.dev (production secret key)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# Resend (verified domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@hiddengift.vn

# Upstash Redis (Singapore region)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=hidden-gift

# Plausible (marketing analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=hiddengift.vn

# PayOS (Phase 3 only — requires KYC business account)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
